{
  "name": "muzeec",
  "private": true,
  "version": "1.3.0",
  "description": "A minimal, modern YouTube Music desktop client.",
  "author": "Bintang M",
  "desktopName": "muzeec.desktop",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/sync-kuromoji.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/sync-kuromoji.mjs",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "pinyin-pro": "^3.29.5",
    "wanakana": "^5.3.1",
    "youtubei.js": "^18.2.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "kuromoji": "^0.1.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.muzeec.app",
    "productName": "Muzeec",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "executableName": "muzeec",
      "syncDesktopName": true,
      "icon": "resources/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
